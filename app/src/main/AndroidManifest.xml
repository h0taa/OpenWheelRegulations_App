<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No permissions are declared. The app is fully offline: it ships its regulation
      data as a bundled asset and stores everything locally. In particular there is no
      INTERNET permission.
    -->

    <application
        android:name=".OWRApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OWR">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OWR">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Icon used should a notification ever be posted. -->
        <meta-data
            android:name="com.openwheel.regulations.notification_icon"
            android:resource="@drawable/ic_notification" />

    </application>

</manifest>
